# Configure only credentials used by targets in model_mapping.json.

# Runtime settings. The public API does not authenticate inbound requests.
# Keep source deployments on loopback unless authentication and network access
# controls are in place. Compose overrides this inside the container.
PROXY_HOST=127.0.0.1
PROXY_PORT=8082

# CONTROL_SOCKET_PATH is optional for source deployments. By default the CLI
# selects XDG_RUNTIME_DIR or another private runtime fallback. An override must
# be an absolute socket path with an existing private parent directory. The
# container uses the container-internal /run/claude-code-proxy/control.sock.

# Maximum inactive logical session rows retained in memory.
SESSION_RETENTION_LIMIT=1000

# Anthropic targets (anthropic/...)
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI targets (openai/...) through LiteLLM
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Gemini targets (gemini/...) through Google AI Studio
# GEMINI_API_KEY="your-google-ai-studio-key"

# Gemini targets through Vertex AI Application Default Credentials
# USE_VERTEX_AUTH=true
# VERTEX_PROJECT="your-gcp-project-id"
# VERTEX_LOCATION="us-central1"

# OpenAI target transport: litellm (default) or codex.
# OPENAI_TRANSPORT="litellm"

# Codex subscription auth directory.
# OPENCODE_DATA_DIR="~/.local/share/opencode"

# Optional path to model mapping configuration.
# MODEL_MAPPING_PATH="model_mapping.json"
