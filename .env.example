# Configure only credentials used by targets in model_mapping.json.

# Anthropic targets (anthropic/...)
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI targets (openai/...) through LiteLLM
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Gemini targets (gemini/...) through Google AI Studio
# GEMINI_API_KEY="your-google-ai-studio-key"

# Gemini targets through Vertex AI Application Default Credentials
# USE_VERTEX_AUTH=true
# VERTEX_PROJECT="your-gcp-project-id"
# VERTEX_LOCATION="us-central1"

# OpenAI target transport: litellm (default) or codex.
# OPENAI_TRANSPORT="litellm"

# Codex subscription auth directory.
# OPENCODE_DATA_DIR="~/.local/share/opencode"

# Optional path to model mapping configuration.
# MODEL_MAPPING_PATH="model_mapping.json"
